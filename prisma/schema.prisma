generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ImageKind {
  AVATAR
  WORK
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String               @unique
  phone             String?
  passwordHash      String
  role              UserRole             @default(CLIENT)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  professional      ProfessionalProfile?
  favorites         Favorite[]
  reviews           Review[]             @relation("ReviewAuthor")
}

model ProfessionalProfile {
  id              String                @id @default(cuid())
  userId          String                @unique
  slug            String                @unique
  headline        String?
  description     String?
  city            String                @default("Foz do Iguaçu")
  state           String                @default("PR")
  neighborhoods   String[]              @default([])
  whatsapp        String?
  yearsExperience Int?
  isVerified      Boolean               @default(false)
  isPublished     Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories      ProfessionalCategory[]
  services        Service[]
  favorites       Favorite[]
  reviews         Review[]
  images          ProfessionalImage[]

  @@index([city, state, isPublished])
}

model Category {
  id            String                @id @default(cuid())
  name          String                @unique
  slug          String                @unique
  groupName     String
  createdAt     DateTime              @default(now())
  professionals ProfessionalCategory[]
  services      Service[]
}

model ProfessionalCategory {
  professionalId String
  categoryId     String
  isPrimary      Boolean             @default(false)
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([professionalId, categoryId])
  @@index([categoryId])
}

model Service {
  id             String                @id @default(cuid())
  professionalId String
  categoryId     String?
  title          String
  description    String?
  priceFrom      Decimal?              @db.Decimal(10, 2)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  professional   ProfessionalProfile   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category       Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([professionalId, isActive])
  @@index([categoryId])
}

model Favorite {
  userId         String
  professionalId String
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional   ProfessionalProfile  @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([userId, professionalId])
  @@index([professionalId])
}

model Review {
  id             String                @id @default(cuid())
  authorId       String
  professionalId String
  rating         Int
  comment        String
  status         ReviewStatus          @default(PENDING)
  serviceConfirmed Boolean             @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  author         User                  @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  professional   ProfessionalProfile   @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([authorId, professionalId])
  @@index([professionalId, status, createdAt])
}


model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ProfessionalImage {
  id             String              @id @default(cuid())
  professionalId String
  kind           ImageKind
  mimeType       String
  data           Bytes
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, kind, createdAt])
}
